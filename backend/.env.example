# FundWatch Backend Environment Configuration

# Database Configuration:
# For production PostgreSQL:
# DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/fundwatch
# Zero-config local development fallback:
DATABASE_URL=sqlite:///./fundwatch.db

# App Settings
DEBUG=True
APP_NAME=FundWatch
JWT_SECRET=fundwatch-secure-demo-secret-key-2026

# Statistical Engine Tuning (Optional overrides)
Z_SCORE_THRESHOLD=3.0
IQR_MULTIPLIER=1.5
